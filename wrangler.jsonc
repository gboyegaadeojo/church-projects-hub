{
  // Church Projects Hub — Cloudflare Worker config.
  // Requirements: docs/REQUIREMENTS.md (section 5 stack, section 18 secrets).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "church-projects-hub",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // React app built by Vite. Static asset requests are free and do not invoke the Worker.
  // Never set a global run_worker_first (section 5 budget rule).
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "church-projects-hub",
      // Production database (created 19 Oct 2026). Local dev and tests use a local copy, never this one.
      "database_id": "483598e8-a78a-466b-8cff-b8e46b803419",
      "migrations_dir": "migrations"
    }
  ],

  "r2_buckets": [
    {
      "binding": "FILES",
      // Attachments only. Nightly database backups go to the separate church-projects-hub-backups
      // bucket (.github/workflows/backup.yml), which the Worker has no binding to.
      "bucket_name": "church-projects-hub-files"
    }
  ],

  // One schedule only (free plan allows 5 per account, shared with the checklist app).
  // worker/jobs/dispatch.ts decides what runs on each tick.
  "triggers": { "crons": ["*/5 * * * *"] },

  // Sign-in rate limit (RATE-1, NFR-4): 30 attempts per minute per IP (church Wi-Fi shares one IP),
  // using the Workers rate-limiting binding so allowed attempts cost no D1 writes. namespace_id is any
  // account-unique number; keep it distinct from the checklist app's limiters.
  "ratelimits": [
    { "name": "SIGNIN_RATE_LIMITER", "namespace_id": "2101", "simple": { "limit": 30, "period": 60 } }
  ],

  // Production values. `npm run dev` overrides APP_BASE_URL from .dev.vars (http://localhost:5174).
  "vars": {
    // Links in emails. Switch to https://hub.ifcwpg.com (and GOOGLE_REDIRECT_URI with it) once that custom domain is live.
    "APP_BASE_URL": "https://church-projects-hub.media-5f7.workers.dev",
    "EMAIL_FROM": "media@ifcwpg.com"
  },

  // Staging (Stage 8 measurements and restore drills): its own Worker, database and bucket, filled only
  // with synthetic load-test data by scripts/loadtest. It never sees production data and has no Resend key,
  // so it never sends email. Build and deploy with: CLOUDFLARE_ENV=staging npm run build && npx wrangler deploy
  "env": {
    "staging": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "church-projects-hub-staging",
          "database_id": "fd4ff66b-6cfd-4b9d-b7ba-8bc20fc4c6a3",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [{ "binding": "FILES", "bucket_name": "church-projects-hub-staging-files" }],
      "triggers": { "crons": ["*/5 * * * *"] },
      "ratelimits": [
        { "name": "SIGNIN_RATE_LIMITER", "namespace_id": "2102", "simple": { "limit": 30, "period": 60 } }
      ],
      "vars": {
        "APP_BASE_URL": "https://church-projects-hub-staging.media-5f7.workers.dev",
        "EMAIL_FROM": "media@ifcwpg.com"
      }
    }
  }
}
