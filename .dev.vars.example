GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/callback
SESSION_SECRET=
BREVO_API_KEY=
CF_ACCOUNT_ID=
CF_ANALYTICS_TOKEN=
